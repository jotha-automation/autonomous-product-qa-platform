# APTP — Environment configuration reference
# Local:  cp .env.example .env  &&  fill required values  &&  make env
# Railway / production: set the same keys in the dashboard (never commit .env)
#
# Required for production (validated by deployment/docker/validate-env.sh):
#   APTP_API_KEY, AZURE_OPENAI_*, GOOGLE_DRIVE_*, APTP_CORS_ORIGINS,
#   AZURE_OPENAI_EMBEDDING_DEPLOYMENT, APTP_ALLOW_MOCKS=false, APTP_USE_MOCK_LLM=false,
#   APTP_PLAYWRIGHT_VERSION — pin aligned with Dockerfile / src/playwright_version.py
#   APTP_SKIP_PLAYWRIGHT_INSTALL=false

# Pin aligned with src/playwright_version.py and Dockerfile (mcr.microsoft.com/playwright)
APTP_PLAYWRIGHT_VERSION=1.61.1

# =============================================================================
# Security & API
# =============================================================================
# Required in production (APTP_ENV=production). Known weak values like dev-api-key are rejected at startup.
APTP_API_KEY=
# deployment | development | production — blocks weak keys and APTP_ALLOW_OPEN_API when production
APTP_ENV=development
# Local dev only: allow requests without APTP_API_KEY (never enable in production)
APTP_ALLOW_OPEN_API=false
# Optional dedicated secret for HMAC run tokens (SSE/downloads); defaults to APTP_API_KEY when unset
APTP_RUN_ACCESS_TOKEN_SECRET=
# Ephemeral run token lifetime in seconds (default 3600)
APTP_RUN_ACCESS_TOKEN_TTL_SECONDS=3600

# Comma-separated origins for CORS (frontend). Local dev example:
# APTP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APTP_CORS_ORIGINS=https://your-frontend.example.com

# =============================================================================
# Infrastructure (database, cache, server)
# =============================================================================
# docker-compose overrides DATABASE_URL / REDIS_URL for the api service; set for Railway.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aptp
REDIS_URL=redis://host:6379/0
# Production multi-worker: require Redis (fail startup if unreachable). Demo default: false.
APTP_REQUIRE_REDIS=false

# HTTP server (entrypoint / Railway)
PORT=8000
APTP_HOST=0.0.0.0
APTP_WAIT_FOR_DB=true
APTP_UVICORN_RELOAD=false
APTP_WEB_WORKERS=1

# Host port mappings (docker compose only — optional)
APTP_POSTGRES_PORT=5432
APTP_REDIS_PORT=6379
APTP_API_PORT=8000

# Bootstrap on startup
# Docker Compose runs Alembic in entrypoint — keep APTP_INIT_DB=false to avoid
# duplicate CREATE TABLE errors (e.g. pipeline_run_records). Use true only for
# first boot without migrations (then stamp: alembic stamp head).
APTP_INIT_DB=false
APTP_RUN_MIGRATIONS=true

# =============================================================================
# Runtime policy (real vs mock)
# =============================================================================
# Production: all false. CI/tests: APTP_ALLOW_MOCKS=true + APTP_USE_MOCK_LLM=true
APTP_ALLOW_MOCKS=false
APTP_USE_MOCK_LLM=false
APTP_SKIP_PLAYWRIGHT_INSTALL=false
APTP_MOCK_PLAYWRIGHT_EXECUTION=false
# Docker/Railway API image sets both automatically — do not override unless you manage browsers yourself:
# APTP_SKIP_PLAYWRIGHT_INSTALL=true
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Per-phase Playwright subprocess time budgets (seconds). On exceed the phase is killed and reported
# as an infra "timeout" failure instead of hanging the run.
APTP_NPM_INSTALL_TIMEOUT_S=300
APTP_PLAYWRIGHT_INSTALL_TIMEOUT_S=300
APTP_PLAYWRIGHT_LIST_TIMEOUT_S=120
APTP_PLAYWRIGHT_PROBE_TIMEOUT_S=120
APTP_PLAYWRIGHT_TEST_TIMEOUT_S=1800

# Mock-only (requires APTP_ALLOW_MOCKS=true)
# APTP_MOCK_EXECUTION_FAILURES=false
# APTP_MOCK_SYSTEM_ROOT=
# APTP_MOCK_DRIVE_ROOT=

# =============================================================================
# Azure OpenAI / AI Foundry (LLM + embeddings)
# =============================================================================
# Foundry models (Kimi, gpt-4.1) use *.services.ai.azure.com — NOT *.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com
# Optional override; auto-derived from AZURE_OPENAI_ENDPOINT if unset
# AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=2024-10-21

# Default deployment when hybrid routing is off, or fallback for codegen
AZURE_OPENAI_DEPLOYMENT=
# Hybrid: gpt-4.1 for QA reasoning agents; Kimi-K2.6 for Playwright codegen
APTP_HYBRID_LLM_ENABLED=true
# When true, 429/unavailable on reasoning retries on codegen (and vice versa)
APTP_LLM_CROSS_PROFILE_FALLBACK=true
AZURE_OPENAI_DEPLOYMENT_REASONING=gpt-4.1
# Empty → uses AZURE_OPENAI_DEPLOYMENT (set Kimi-K2.6 here or in CODEGEN)
AZURE_OPENAI_DEPLOYMENT_CODEGEN=Kimi-K2.6

# Temperature (used when agents do not pass an explicit value)
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_TEMPERATURE_REASONING=0.15
AZURE_OPENAI_TEMPERATURE_CODEGEN=0.08

# Completion tokens (see also APTP_* token policy below)
AZURE_OPENAI_MAX_CONCURRENCY=4
AZURE_OPENAI_CACHE_ENABLED=true
AZURE_OPENAI_CACHE_TTL_SECONDS=900
AZURE_OPENAI_CACHE_MAX_ENTRIES=1024

# Embeddings (pgvector) — run alembic 006 after changing dimensions
APTP_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# =============================================================================
# LLM prompt & response budgets (src/agents/token_policy.py)
# =============================================================================
# Scales with intake/output size up to these ceilings
APTP_DEFAULT_PROMPT_CHARS=64000
APTP_MAX_PROMPT_CHARS=350000
APTP_DEFAULT_MAX_OUTPUT_TOKENS=16384
APTP_MAX_OUTPUT_TOKENS=32768
APTP_MAX_OUTPUT_TOKENS_CEILING=32768
# Codegen agents (PlaywrightGeneratorAgent) emit large TS projects. Their 65536 budget was being
# silently clamped to APTP_MAX_OUTPUT_TOKENS_CEILING; this profile-aware ceiling keeps it intact.
APTP_CODEGEN_MAX_OUTPUT_TOKENS_CEILING=65536
APTP_REASONING_MAX_OUTPUT_TOKENS=32768
APTP_CODEGEN_MAX_OUTPUT_TOKENS=65536
APTP_OUTPUT_TOKENS_PER_ITEM=96
APTP_OUTPUT_TOKENS_INCREMENTAL_CAP=24000
APTP_MIN_OUTPUT_TOKENS=4096
APTP_INTAKE_MAX_DOC_CHARS=200000
APTP_INTAKE_MAX_DOCUMENTS=32
# Playwright live exploration (bank portal) — cap scenarios to keep generator fast
APTP_EXPLORE_MAX_SCENARIOS=12
APTP_EXPLORE_SCENARIO_TIMEOUT_SEC=90
APTP_EXPLORE_STEP_TIMEOUT_MS=8000
# Set true to skip browser walk entirely during codegen
# APTP_SKIP_PLAYWRIGHT_EXPLORE=false
# Playwright codegen batch sizing (full suite coverage)
# "auto" = dynamic sizing based on scenario count: 4 (≤4), 8 (≤16), 12 (≤32), 16 (32+)
# Or set explicit number 1-24 (higher = fewer LLM calls but larger prompts)
APTP_PLAYWRIGHT_CODEGEN_BATCH_SIZE=auto

# Max concurrent LLM calls during codegen (controlled parallelism)
# Higher = faster wall-clock time but more API pressure; 2 is safe default
APTP_CODEGEN_MAX_CONCURRENT=2

# =============================================================================
# Google Drive
# =============================================================================
# Service account JSON (inline). APTP/ root must be in a Shared Drive (Workspace)
# or use GOOGLE_DRIVE_IMPERSONATE_USER for domain-wide delegation.
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Alternative to inline JSON: path to credentials file inside the container
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

GOOGLE_DRIVE_SYSTEM_ROOT_FOLDER_ID=
# Legacy alias for SYSTEM_ROOT_FOLDER_ID
# GOOGLE_DRIVE_DEFAULT_FOLDER_ID=

# Shared Drive folder name (default: APTP)
GOOGLE_DRIVE_SYSTEM_ROOT_NAME=APTP

# Webhook push notifications (Drive → APTP). Register with scripts/register_drive_watch.py
GOOGLE_DRIVE_WEBHOOK_SECRET=
# Public URL where APTP receives Drive push notifications (production)
# APTP_WEBHOOK_URL=https://your-api.example.com/api/v1/webhooks/drive

# HTTP / retry tuning
GOOGLE_DRIVE_HTTP_TIMEOUT=30
GOOGLE_DRIVE_OPERATION_TIMEOUT=90
GOOGLE_DRIVE_RETRY_ATTEMPTS=4
GOOGLE_DRIVE_MAX_CONCURRENCY=2

# Google Workspace: domain-wide delegation (uploads use this user's quota)
# GOOGLE_DRIVE_IMPERSONATE_USER=you@yourcompany.com

# Default project_id when webhook payload omits it
# GOOGLE_DRIVE_DEFAULT_PROJECT_ID=demo

# Intake registry in Postgres (disable only for debugging)
APTP_DISABLE_INTAKE_DB=false

# =============================================================================
# Drive watcher & pipeline triggers
# =============================================================================
APTP_DRIVE_WATCH_ENABLED=true
# When true, watcher may auto-run the pipeline after file changes on projects
# that were already processed at least once. First runs always require the operator.
APTP_DRIVE_WATCH_TRIGGER_RUN=false
APTP_DRIVE_POLL_INTERVAL=300
# Mode used by watcher when auto-triggering runs: full | phase1
APTP_DRIVE_DEFAULT_MODE=full
# Default mode for manual process / API (full | phase1)
APTP_DEFAULT_PIPELINE_MODE=full

# =============================================================================
# Playwright execution & generated projects
# =============================================================================
PLAYWRIGHT_PROJECTS_ROOT=generated-test-projects
# Bank portal demo: serve pre-verified INC1353166 Playwright template (transparent to UI)
APTP_USE_GOLDEN_PLAYWRIGHT=true
# Demo: skip PW architect/generator/validation agents; materialize golden template and execute once (no healing)
APTP_GOLDEN_ONLY=true
# Override TestLink spec path for golden template rebuild (default: src/automation/fixtures/.../inc1353166-testlink.txt)
# APTP_INC1353166_SPEC_PATH=/path/to/pruebas-inc1353166.pdf.txt
# Set automatically in Docker image (see src/playwright_version.py); override only for custom browser installs
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Self-healing loop (orchestrator)
MAX_HEAL_ATTEMPTS=2
HEAL_CONFIDENCE_THRESHOLD=0.55

# Evidence PDF report
APTP_PDF_MAX_SCREENSHOTS=12

# =============================================================================
# Secrets & compliance (Phase 3)
# =============================================================================
# Provider: env (default, demo/local) | azure_key_vault (production)
APTP_SECRETS_PROVIDER=env
# Fernet key material for encrypting run-scoped secrets at rest (demo/local)
# APTP_SECRETS_ENCRYPTION_KEY=
# Azure Key Vault URL when APTP_SECRETS_PROVIDER=azure_key_vault
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# TTL for run_secret:* entries in Redis/memory (seconds; default 1h)
APTP_RUN_SECRET_TTL_SECONDS=3600
# Bank portal demo credentials — set false in production
APTP_ALLOW_DEMO_SECRETS=true
APTP_DEMO_LOGIN_USER_CLIENTE=312
APTP_DEMO_LOGIN_USER_TIPO_ID=CC
APTP_DEMO_LOGIN_USER_DOCUMENTO=20242587
APTP_DEMO_LOGIN_USER_CLAVE=123456
APTP_DEMO_LOGIN_USER_TOKEN=63866019
APTP_DEMO_NO_TOKEN_CLIENTE=201319
APTP_DEMO_NO_TOKEN_TIPO_ID=CC
APTP_DEMO_NO_TOKEN_DOCUMENTO=1233896904
APTP_DEMO_NO_TOKEN_CLAVE=2023
APTP_DEMO_NO_TOKEN_TOKEN=

# Intake pipeline routing, MCP toggles, and AI-always flags are auto-detected from
# project documents — no behavior env vars required. MCP runs in-process when
# mcp/aptp_intake_tools/ is present.

# =============================================================================
# Azure Service Bus (optional — events fan-out; disabled if unset)
# =============================================================================
# AZURE_SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=aptp-events
